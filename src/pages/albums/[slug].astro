---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'

export async function getStaticPaths() {
	const allAlbums = await getCollection('albums')
	return allAlbums.map((album) => ({
		params: { slug: album.id },
		props: { album },
	}))
}

const { slug } = Astro.params
const albumPhotos = await getCollection('photos', ({ data }) => {
	return data.collection === slug
})
---

<h2>{slug} photos</h2>
<ul>
	{
		albumPhotos.map(({ data: { title, description, image } }) => (
			<li>
				<h3>{title}</h3>
				<p>{description}</p>
				<Image src={image} alt={title} width={1200} class="w-full h-auto" />
			</li>
		))
	}
</ul>
