---
import { getCollection } from 'astro:content'
import Layout from '@layouts/BaseLayout.astro'
const allAlbums = await getCollection('albums')
---

<Layout>
	<h1>My albums</h1>
	<ul>
		{
			allAlbums.map((album) => (
				<li>
					<a href={`/albums/${album.id}`}>{album.data.title} - {album.data.date}</a>
				</li>
			))
		}
	</ul>
</Layout>
