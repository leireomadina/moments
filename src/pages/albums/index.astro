---
import { getCollection } from 'astro:content'
import Layout from '@layouts/BaseLayout.astro'
import { ROUTES } from '@utils/routes'

const allAlbums = await getCollection('albums')
---

<Layout
	title="Albums"
	description="A collection of photo albums from different trips and places."
>
	<h1 class="mb-12">My albums</h1>
	<ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
		{
			allAlbums.map(({ id, data: { title, date } }) => (
				<li class="border border-gray-100 p-6 rounded-lg hover:shadow-md transition-shadow">
					<a href={ROUTES.albums.detail(id)} class="block space-y-2">
						<h2 class="text-2xl font-serif">{title}</h2>
						<p class="text-gray-500 font-sans">{date}</p>
					</a>
				</li>
			))
		}
	</ul>
</Layout>
