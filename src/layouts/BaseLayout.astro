---
import '../styles/global.css'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'

interface Props {
	title?: string
	description?: string
}

const {
	title = 'Moments',
	description = 'Moments is a photo repository made by Leire Ordeñana Madina, a web developer based in Getxo.',
} = Astro.props

const formattedTitle = title === 'Moments' ? title : `${title} | Moments`
---

<!doctype html>
<html lang="en">
	<head>
		<title>{formattedTitle}</title>
		<meta charset="utf-8" />
		<meta name="description" content={description} />
		<meta name="author" content="Leire Ordeñana Madina" />
		<meta
			name="keywords"
			content="photo, photography, moments, web developer, developer"
		/>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
	</head>
	<body class="flex flex-col min-h-screen">
		<Header />
		<main class="flex-grow max-w-7xl mx-auto w-full px-8 py-12">
			<slot />
		</main>
		<Footer />
	</body>
</html>
